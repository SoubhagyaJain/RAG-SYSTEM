# =============================================================================
# Enterprise Agentic RAG System - Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM / Embedding Provider Keys (at minimum one LLM + embedding provider)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# Optional providers (uncomment and configure as you add support)
# ANTHROPIC_API_KEY=...
# COHERE_API_KEY=...
# GROQ_API_KEY=...
# TOGETHER_API_KEY=...
# FIREWORKS_API_KEY=...
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# -----------------------------------------------------------------------------
# Vector Database / External Services (Phase 1+)
# -----------------------------------------------------------------------------
# CHROMA_PERSIST_DIRECTORY=./data/vectorstore/chroma
# PINECONE_API_KEY=...
# PINECONE_ENVIRONMENT=...
# WEAVIATE_URL=...
# WEAVIATE_API_KEY=...

# -----------------------------------------------------------------------------
# Observability / Tracing (future)
# -----------------------------------------------------------------------------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=...
# LANGCHAIN_PROJECT=enterprise-rag-ai-agents
# OTEL_EXPORTER_OTLP_ENDPOINT=...

# -----------------------------------------------------------------------------
# Application Settings (can also be set in config.yaml)
# -----------------------------------------------------------------------------
# RAG_ENV=development
# LOG_LEVEL=INFO
