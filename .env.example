# =============================================================================
# Enterprise Agentic RAG System - Environment Variables (LlamaIndex + Ollama)
# Copy to .env and configure as needed.
# =============================================================================

# Ollama connection (default is localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: If you later use LlamaCloud / LlamaParse
# LLAMA_CLOUD_API_KEY=...

# Optional future cloud providers (keep empty for fully local setup)
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...

# Ragas / evaluation specific (if using hosted judge models later)
# RAGAS_OPENAI_API_KEY=...

# Logging / runtime
# RAG_ENV=development
# LOG_LEVEL=INFO
